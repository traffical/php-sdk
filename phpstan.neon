parameters:
    level: max
    paths:
        - src
    treatPhpDocTypesAsCertain: false
    # Optional framework integrations extend classes from packages that are not
    # part of require/require-dev (illuminate/support, symfony/*, open-feature/sdk).
    # They cannot be statically analysed without those packages installed, so they
    # are excluded from this run. Install the relevant optional package and drop
    # the matching excludePath to analyse an integration locally.
    excludePaths:
        - src/Laravel/*
        - src/Symfony/*
        - src/OpenFeature/*
